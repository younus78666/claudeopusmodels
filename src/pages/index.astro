---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroCard from "../components/HeroCard.astro";
import ListCard from "../components/ListCard.astro";
import {
  filterTags,
  posts,
  siteDescription,
  siteName,
  siteUrl,
  silos,
} from "../content";

function tagHref(tag: string): string {
  if (tag === "all") return "/";
  const silo = silos.find((s) => s.slug === tag);
  return silo ? silo.href : "/";
}

const featured = posts[0];
const rest = posts.slice(1);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    name: siteName,
    url: `${siteUrl}/`,
    description: siteDescription,
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: siteName,
    url: siteUrl,
    description: siteDescription,
  },
];
---

<BaseLayout
  title={`${siteName} | Expert AI Model Analysis`}
  description={siteDescription}
  path="/"
  type="website"
  schema={schema}
>
  <div>
    <div class="feed-header">
      <h1>Latest Insights</h1>
      <p>
        Expert analysis of Claude models, AI safety, and building trustworthy
        AI applications.
      </p>
    </div>

    <div class="tag-filters">
      {
        filterTags.map((tag) => (
          <a
            class={`tag-btn ${tag === "all" ? "active" : ""}`}
            href={tagHref(tag)}
          >
            {tag}
          </a>
        ))
      }
    </div>

    {featured && <HeroCard post={featured} />}

    <div class="list-layout">
      {rest.map((post, i) => <ListCard post={post} index={i} />)}
    </div>
  </div>
</BaseLayout>
