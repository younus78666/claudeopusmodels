---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteUrl } from "../content";

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact Claude Model Insights",
  description:
    "Contact the Claude Model Insights team with questions, corrections, or collaboration ideas.",
  url: `${siteUrl}/contact/`,
  mainEntity: {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: "Claude Model Insights",
    email: "contact@claudeopusmodels.com",
    url: siteUrl,
  },
};
---

<BaseLayout
  title="Contact Claude Model Insights | Get in Touch"
  description="Have a question, correction, or collaboration idea? Contact the Claude Model Insights team. We respond to every message within 48 business hours."
  path="/contact/"
  schema={schema}
>
  <div class="feed-header">
    <h1>Contact Us</h1>
  </div>

  <article class="article-body" style="max-width: 760px; margin: 0 auto;">
    <p>
      Got a question about one of our articles? Found an error that needs
      correcting? Want to suggest a topic? We'd like to hear from you.
    </p>

    <h2>Ways to Reach Us</h2>
    <p>
      <strong>Email:</strong>
      <a href="mailto:contact@claudeopusmodels.com"
        >contact@claudeopusmodels.com</a
      >
    </p>
    <p>
      <strong>Response time:</strong> We respond to every message within 48
      business hours. Corrections and factual accuracy reports get priority.
    </p>

    <h2>What We Can Help With</h2>
    <p>
      <strong>Content corrections.</strong> If you've spotted an error in
      any article (wrong pricing, outdated feature, broken link), email us
      with the article URL and what needs fixing. We take accuracy
      seriously and update articles within 24 hours for verified
      corrections.
    </p>
    <p>
      <strong>Topic suggestions.</strong> Have a Claude Code question
      nobody's answered well? Tell us what you're trying to figure out and
      we'll consider it for a future article.
    </p>
    <p>
      <strong>Collaboration.</strong> We're open to guest contributions
      from practitioners with genuine hands-on experience. We don't accept
      AI-generated guest posts or paid placements.
    </p>

    <h2>What We Can't Help With</h2>
    <p>
      <strong>Claude Code tech support.</strong> We're an independent
      publication, not Anthropic's support team. For account issues,
      billing questions, or bug reports, contact Anthropic directly at <a
        href="https://support.anthropic.com">support.anthropic.com</a
      >.
    </p>
    <p>
      <strong>Personal project help.</strong> We can't debug your specific
      Claude Code project via email. But if your question is common
      enough, it might become an article that helps everyone.
    </p>

    <h2>Connect on Social</h2>
    <ul>
      <li>
        Website: <a href="https://muhammadyounus.com"
          >muhammadyounus.com</a
        >
      </li>
      <li>
        LinkedIn: <a href="https://linkedin.com/in/muhammadyounus"
          >linkedin.com/in/muhammadyounus</a
        >
      </li>
    </ul>
  </article>
</BaseLayout>
