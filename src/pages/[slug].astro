---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import {
  posts,
  siteName,
  siteUrl,
  silos,
  type BlogPost,
} from "../content";

export async function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props as Props;
const path = `/${post.slug}/`;

const primarySilo = silos.find((s) => post.tags.includes(s.slug));

const baseSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  description: post.excerpt,
  datePublished: post.datePublishedISO ?? post.date,
  dateModified: post.datePublishedISO ?? post.date,
  author: {
    "@type": "Person",
    "@id": `${siteUrl}/#author`,
    name: "Muhammad Younus",
    url: `${siteUrl}/author/muhammad-younus/`,
  },
  publisher: {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: siteName,
    url: siteUrl,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${siteUrl}${path}`,
  },
  ...(primarySilo && { articleSection: primarySilo.label }),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Articles",
      item: `${siteUrl}/`,
    },
    ...(primarySilo
      ? [
          {
            "@type": "ListItem",
            position: 2,
            name: primarySilo.label,
            item: `${siteUrl}${primarySilo.href}`,
          },
        ]
      : []),
    {
      "@type": "ListItem",
      position: primarySilo ? 3 : 2,
      name: post.title,
      item: `${siteUrl}${path}`,
    },
  ],
};

const schemaArray: object[] = [baseSchema, breadcrumbSchema];
if (post.extraSchema) {
  if (Array.isArray(post.extraSchema)) schemaArray.push(...post.extraSchema);
  else schemaArray.push(post.extraSchema);
}

const tocItems = (post.toc as Array<{ id: string; label: string } | string>).map(
  (entry) =>
    typeof entry === "string"
      ? { id: entry.toLowerCase().replace(/[^a-z0-9]+/g, "-"), label: entry }
      : entry
);

// Fallback simple-body renderer (used when bodyHtml not provided)
const paragraphs = post.bodyHtml
  ? []
  : post.body.split("\n\n").map((para, i) => {
      if (para.startsWith("## ")) {
        return {
          type: "h2" as const,
          id: `section-${i}`,
          content: para.replace("## ", ""),
        };
      }
      return {
        type: "p" as const,
        id: `p-${i}`,
        content: para.replace(
          /\*\*(.*?)\*\*/g,
          `<strong style="color:${post.color}">$1</strong>`
        ),
      };
    });
---

<BaseLayout
  title={post.seoTitle ?? `${post.title} | ${siteName}`}
  description={post.excerpt}
  path={path}
  type="article"
  schema={schemaArray}
>
  <div>
    <div class="post-top-bar">
      <a class="back-btn" href="/">
        <Icon name="arrow" size={16} /> All articles
      </a>
    </div>

    <nav class="article-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Articles</a>
      <span class="sep">›</span>
      {
        primarySilo ? (
          <a href={primarySilo.href}>{primarySilo.label}</a>
        ) : (
          <span class="current">{post.category}</span>
        )
      }
      {primarySilo && <span class="sep">›</span>}
      {primarySilo && <span class="current">{post.category}</span>}
    </nav>

    <div
      class="article-header"
      style={`background: linear-gradient(135deg, ${post.color}10 0%, ${post.color}04 100%); border: 1px solid ${post.color}20;`}
    >
      <div class="circle-1" style={`background: ${post.color}08;`}></div>
      <div class="circle-2" style={`background: ${post.color}06;`}></div>

      <div class="article-header-content">
        <div
          class="category-badge"
          style={`background: ${post.color}18; color: ${post.color};`}
        >
          {post.category}
        </div>

        <h1>{post.title}</h1>
        <p class="excerpt">{post.excerpt}</p>

        <div class="article-author-row">
          <a
            href="/author/muhammad-younus/"
            style="display: flex; align-items: center; gap: 10px; text-decoration: none;"
          >
            <div class="author-avatar" style={`background: ${post.color};`}>
              M
            </div>
            <div class="author-info">
              <div class="author-name">Muhammad Younus</div>
              <div class="author-role">{post.authorRole}</div>
            </div>
          </a>
          <div class="author-divider"></div>
          <div class="article-meta">
            <time datetime={post.datePublishedISO ?? ""}>{post.date}</time>
            <span class="meta-icon">
              <Icon name="clock" size={13} /> {post.readTime}
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="key-takeaway" style={`border-left-color: ${post.color};`}>
      <div class="key-takeaway-label" style={`color: ${post.color};`}>
        Key Takeaway
      </div>
      <p>{post.keyTakeaway}</p>
    </div>

    <div class="article-layout">
      <article class="article-body">
        {
          post.bodyHtml ? (
            <div set:html={post.bodyHtml} />
          ) : (
            paragraphs.map((para) =>
              para.type === "h2" ? (
                <h2 id={para.id}>{para.content}</h2>
              ) : (
                <p set:html={para.content} />
              )
            )
          )
        }
      </article>

      {
        tocItems.length > 0 && (
          <aside class="article-sidebar">
            <div class="toc-panel">
              <div class="toc-label">In this article</div>
              {tocItems.map((item, i) => (
                <a
                  href={`#${item.id}`}
                  class={`toc-item ${i === 0 ? "active" : ""}`}
                  style={i === 0 ? `border-left-color: ${post.color};` : ""}
                >
                  {item.label}
                </a>
              ))}
            </div>

            <div
              class="expert-panel"
              style={`background: ${post.color}08; border: 1px solid ${post.color}15;`}
            >
              <div class="expert-label" style={`color: ${post.color};`}>
                Source
              </div>
              <p>{post.expertCredentials}</p>
            </div>
          </aside>
        )
      }
    </div>

    <div class="article-tags">
      {
        post.tags.map((t) => {
          const linked = silos.find((s) => s.slug === t);
          return linked ? (
            <a class="article-tag" href={linked.href}>
              {t}
            </a>
          ) : (
            <span class="article-tag">{t}</span>
          );
        })
      }
    </div>

    <div class="continue-reading">
      <div class="label">Continue Reading</div>
      <p>
        Explore more insights on Claude models, AI safety, and building
        trustworthy AI applications.
      </p>
      <a class="continue-reading-btn" href="/">Browse All Articles</a>
    </div>
  </div>
</BaseLayout>
