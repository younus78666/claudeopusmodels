---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiloArchive from "../components/SiloArchive.astro";
import { silos, siteUrl, postsBySilo } from "../content";

const silo = silos.find((s) => s.slug === "industry")!;
const noindex = postsBySilo(silo.slug).length === 0;
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${silo.label} | Claude Model Insights`,
  description: silo.description,
  url: `${siteUrl}${silo.href}`,
};
---

<BaseLayout
  title={`${silo.label} | Claude in Finance, Healthcare, Legal & Enterprise`}
  description={silo.description}
  path={silo.href}
  schema={schema}
  noindex={noindex}
>
  <SiloArchive silo={silo} accent="#A3787B" />
</BaseLayout>
