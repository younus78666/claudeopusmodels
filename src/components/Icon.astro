---
export interface Props {
  name: "search" | "arrow" | "x" | "clock" | "share" | "bookmark" | "list" | "grid";
  size?: number;
  color?: string;
}

const { name, size = 20, color = "currentColor" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === "search" && (
    <>
      <circle cx="11" cy="11" r="8"></circle>
      <path d="M21 21l-4.35-4.35"></path>
    </>
  )}
  {name === "arrow" && <path d="M19 12H5m7-7l-7 7 7 7"></path>}
  {name === "x" && <path d="M18 6L6 18M6 6l12 12"></path>}
  {name === "clock" && (
    <>
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M12 6v6l4 2"></path>
    </>
  )}
  {name === "share" && (
    <>
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98"></path>
    </>
  )}
  {name === "bookmark" && (
    <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
  )}
  {name === "list" && (
    <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>
  )}
  {name === "grid" && (
    <path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"></path>
  )}
</svg>
